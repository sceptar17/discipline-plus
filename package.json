{
  "name": "fitness-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler dev --var ENVIRONMENT:development --var ACCESS_TEAM_DOMAIN:local.invalid --var ACCESS_AUD:local",
    "build": "wrangler types --strict-vars=false && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply discipline-plus --local",
    "db:migrate:remote": "wrangler d1 migrations apply discipline-plus --remote"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wrangler": "^4.125.0"
  }
}
